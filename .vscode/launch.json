{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "后端 (uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["backend.app.main:app", "--reload", "--port", "8811"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "流水线 (整条)",
      "type": "debugpy",
      "request": "launch",
      "module": "vn_workflow.pipeline",
      "args": ["--name", "americano"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "闸门：剧本",
      "type": "debugpy",
      "request": "launch",
      "module": "vn_workflow.s1_lint_ink",
      "args": ["--name", "americano"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "闸门：素材",
      "type": "debugpy",
      "request": "launch",
      "module": "vn_workflow.s3_lint_art",
      "args": ["--name", "americano"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Python: 当前文件",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "pytest",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    }
  ]
}
